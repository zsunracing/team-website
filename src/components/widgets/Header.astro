---
import Logo from "~/components/Logo.astro";
import ToggleMenu from "~/components/common/ToggleMenu.astro";
import Button from "~/components/ui/Button.astro";

import { getHomePermalink, trimSlash } from "~/utils/permalinks";
import type { CallToAction } from "~/types";

interface Link {
  text?: string;
  href?: string;
  ariaLabel?: string;
}

interface MenuLink extends Link {
  links?: Array<MenuLink>;
}

export interface Props {
  id?: string;
  links?: Array<MenuLink>;
  actions?: Array<CallToAction>;
  isSticky?: boolean;
  isDark?: boolean;
  isFullWidth?: boolean;
  showToggleTheme?: boolean;
  showRssFeed?: boolean;
  position?: string;
}

const {
  id = "header",
  links = [],
  actions = [],
  isSticky = false,
  isDark = true,
  isFullWidth = false,
} = Astro.props;

const currentPath = `/${trimSlash(new URL(Astro.url).pathname)}`;
---

<header
  class:list={[
    { sticky: isSticky, relative: !isSticky, dark: isDark },
    "zsun-site-header top-0 z-40 flex-none mx-auto w-full transition-[background,border-color,box-shadow] ease-in-out",
  ]}
  {...isSticky ? { "data-aw-sticky-header": true } : {}}
  {...id ? { id } : {}}
>
  <div
    class:list={[
      "zsun-header-inner relative flex min-h-[76px] w-full items-center justify-between gap-4 px-5 md:px-6 mx-auto",
      {
        "max-w-[1180px]": !isFullWidth,
      },
    ]}
  >
    <div class="flex items-center justify-between">
      <a
        class="flex items-center"
        href={getHomePermalink()}
        aria-label="ZSUN home"
      >
        <Logo />
      </a>
      <div class="flex items-center md:hidden">
        <ToggleMenu
          class="zsun-nav-toggle flex h-11 w-11 flex-col items-center justify-center rounded-xl cursor-pointer group"
        />
      </div>
    </div>

    <nav
      class="zsun-nav-links hidden items-center w-full md:w-auto md:flex md:mx-3 overflow-y-auto overflow-x-hidden md:overflow-visible"
      aria-label="Main navigation"
    >
      <ul
        class="flex w-full flex-col gap-1 text-lg font-bold md:w-auto md:flex-row md:items-center md:text-[0.94rem]"
      >
        {
          links.map(({ text, href }) => (
            <li>
              <a
                class:list={[
                  "zsun-nav-link",
                  {
                    "is-active":
                      href === currentPath ||
                      (href === "/" && currentPath === "/"),
                  },
                ]}
                href={href}
              >
                {text}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="zsun-header-actions hidden items-center justify-end md:flex">
      {
        actions?.length ? (
          <span class="flex items-center gap-2">
            {actions.map((btnProps) => (
              <Button
                {...btnProps}
                variant="primary"
                class="zsun-header-action"
              />
            ))}
          </span>
        ) : null
      }
    </div>
  </div>
</header>
