---
import { Icon } from "astro-icon/components";
import { SITE } from "astrowind:config";
import { getHomePermalink } from "~/utils/permalinks";

interface Link {
  text?: string;
  href?: string;
  ariaLabel?: string;
  icon?: string;
}

interface Links {
  title?: string;
  links: Array<Link>;
}

export interface Props {
  links: Array<Links>;
  secondaryLinks: Array<Link>;
  socialLinks: Array<Link>;
  footNote?: string;
  theme?: string;
}

const {
  socialLinks = [],
  secondaryLinks = [],
  links = [],
  footNote = "",
  theme = "dark",
} = Astro.props;
---

<footer class:list={[{ dark: theme === "dark" }, "zsun-site-footer not-prose"]}>
  <div class="zsun-container">
    <div class="zsun-footer-grid">
      <div class="zsun-footer-brand">
        <a
          class="inline-flex items-center font-semibold text-white"
          href={getHomePermalink()}>{SITE?.name}</a
        >
        <p>
          Ride. Race. Improve. Belong. A global Zwift cycling community with
          social riding, structured racing and practical performance support.
        </p>
        {
          secondaryLinks?.length ? (
            <div class="zsun-footer-secondary">
              {secondaryLinks.map(({ text, href }, index) => (
                <>
                  {index !== 0 ? <span aria-hidden="true">/</span> : null}
                  <a href={href} set:html={text} />
                </>
              ))}
            </div>
          ) : null
        }
      </div>

      {
        links.map(({ title, links }) => (
          <div class="zsun-footer-column">
            <h2>{title}</h2>
            {links && Array.isArray(links) && links.length > 0 ? (
              <ul>
                {links.map(({ text, href, ariaLabel }) => (
                  <li>
                    <a href={href} aria-label={ariaLabel}>
                      <Fragment set:html={text} />
                    </a>
                  </li>
                ))}
              </ul>
            ) : null}
          </div>
        ))
      }
    </div>

    <div class="zsun-footer-bottom">
      <div class="text-sm">
        <Fragment set:html={footNote} />
      </div>
      {
        socialLinks?.length ? (
          <ul class="zsun-social-links">
            {socialLinks.map(({ ariaLabel, href, text, icon }) => (
              <li>
                <a aria-label={ariaLabel} href={href}>
                  {icon && <Icon name={icon} class="h-5 w-5" />}
                  <Fragment set:html={text} />
                </a>
              </li>
            ))}
          </ul>
        ) : null
      }
    </div>
  </div>
</footer>
