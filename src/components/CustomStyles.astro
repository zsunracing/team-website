---
import "@fontsource-variable/inter";
---

<style is:inline>
  :root {
    --aw-font-sans: "Inter Variable";
    --aw-font-serif: "Inter Variable";
    --aw-font-heading: "Inter Variable";

    --aw-color-primary: rgb(239 35 60);
    --aw-color-secondary: rgb(255 138 0);
    --aw-color-accent: rgb(255 194 71);

    --aw-color-text-heading: rgb(246 247 251);
    --aw-color-text-default: rgb(246 247 251);
    --aw-color-text-muted: rgb(170 178 197);
    --aw-color-bg-page: rgb(7 9 15);
    --aw-color-bg-page-dark: rgb(7 9 15);

    --zsun-bg: #07090f;
    --zsun-bg-soft: #0d111c;
    --zsun-panel: #121827;
    --zsun-panel-2: #161e30;
    --zsun-text: #f6f7fb;
    --zsun-muted: #aab2c5;
    --zsun-line: rgb(255 255 255 / 12%);
    --zsun-red: #ef233c;
    --zsun-red-dark: #b41224;
    --zsun-orange: #ff8a00;
    --zsun-gold: #ffc247;
    --zsun-green: #35d07f;
    --zsun-shadow: 0 24px 80px rgb(0 0 0 / 35%);
    --zsun-radius: 22px;
    --zsun-max: 1180px;

    ::selection {
      background-color: rgb(239 35 60 / 45%);
      color: white;
    }
  }

  .dark {
    --aw-font-sans: "Inter Variable";
    --aw-font-serif: "Inter Variable";
    --aw-font-heading: "Inter Variable";

    --aw-color-primary: rgb(239 35 60);
    --aw-color-secondary: rgb(255 138 0);
    --aw-color-accent: rgb(255 194 71);

    --aw-color-text-heading: rgb(246 247 251);
    --aw-color-text-default: rgb(246 247 251);
    --aw-color-text-muted: rgb(170 178 197);
    --aw-color-bg-page: rgb(7 9 15);
    --aw-color-bg-page-dark: rgb(7 9 15);
  }
</style>
