---
import Layout from "~/layouts/PageLayout.astro";
import Image from "~/components/common/Image.astro";
import ZsunCard from "~/components/zsun/ZsunCard.astro";
import ZsunFeatureBand from "~/components/zsun/ZsunFeatureBand.astro";
import ZsunPageHero from "~/components/zsun/ZsunPageHero.astro";
import ZsunSection from "~/components/zsun/ZsunSection.astro";
import type { CallToAction } from "~/types";
import aboutHeroImage from "~/assets/images/zsun/zsunr-wide-59-clean.jpg";
import aboutCommunityImage from "~/assets/images/zsun/zsun-base-builder-7.jpg";

const metadata = {
  title: "About",
  description:
    "About ZSUN, a global Zwift cycling community built around friendly riding, fair racing, rider development and belonging.",
};

const missionCards = [
  {
    title: "Who we are",
    text: "ZSUN brings together riders from around the world, from new Zwifters and social riders to experienced racers competing across major virtual racing series.",
  },
  {
    title: "Why riders stay",
    text: "People come for the rides and races, but they stay because the club feels welcoming, active and human. The community matters as much as the result.",
  },
  {
    title: "What we do",
    text: "We support social rides, structured racing, team time trials, rider resources, coaching insight and practical help for riders who want to improve.",
  },
  {
    title: "How ZSUN works",
    text: "ZSUN is built by riders for riders. Ride leaders, captains, organisers, coaches, admins and volunteers all help keep the club active and well organised.",
  },
];

const values = [
  {
    title: "Teamwork",
    text: "We ride, race and improve together. Strong teams are built on clear communication and shared effort.",
  },
  {
    title: "Friendship",
    text: "ZSUN should feel friendly and welcoming. Real friendship is part of the club, not a bonus extra.",
  },
  {
    title: "Good sportsmanship",
    text: "Race hard, race fair and respect other riders. Good sportsmanship is expected from everyone.",
  },
  {
    title: "Courtesy",
    text: "We keep communication constructive, respectful and useful, whether on a social ride, in Discord or during racing.",
  },
  {
    title: "Diversity",
    text: "Riders of different backgrounds, abilities, countries and goals are welcome. Our diversity makes the club stronger.",
  },
  {
    title: "Honesty",
    text: "Fair racing, clear communication and transparent behaviour matter.",
  },
  {
    title: "Courage",
    text: "We encourage riders to take on challenges, support others and keep improving.",
  },
];

const pathways: Array<{
  eyebrow: string;
  title: string;
  text: string;
  action: CallToAction;
}> = [
  {
    eyebrow: "Community rides",
    title: "Ride socially",
    text: "Join regular rides, meet other riders and stay connected through Discord and club activity.",
    action: {
      text: "Ride with us",
      href: "/ride",
      variant: "secondary",
    },
  },
  {
    eyebrow: "Team racing",
    title: "Race with a team",
    text: "Explore ZSUN racing, TTTs, ZRL and the team support available through the racing channels.",
    action: {
      text: "Race with us",
      href: "/race",
      variant: "secondary",
    },
  },
  {
    eyebrow: "Rider development",
    title: "Improve as a rider",
    text: "Use the Performance Hub, rider resources and coaching options to build knowledge, confidence and performance.",
    action: {
      text: "Explore coaching",
      href: "/coaching",
      variant: "secondary",
    },
  },
];
---

<Layout metadata={metadata}>
  <Fragment slot="announcement"></Fragment>

  <ZsunPageHero
    eyebrow="About ZSUN"
    title='<span class="zsun-gradient-text">Ride. Race. Improve. Belong.</span>'
    lead="ZSUN is an international online cycling community built around friendly riding, fair racing, teamwork and rider development."
    actions={[
      {
        text: "Join ZSUN",
        href: "/join",
        variant: "primary",
      },
      {
        text: "Explore social rides",
        href: "/ride",
        variant: "secondary",
      },
      {
        text: "Explore racing",
        href: "/race",
        variant: "secondary",
      },
    ]}
    class="zsun-page-hero-with-visual"
  >
    <div
      slot="visual"
      class="zsun-hero-visual zsun-hero-visual-photo zsun-hero-visual-resources"
      aria-hidden="true"
    >
      <div class="zsun-hero-photo-frame">
        <Image
          src={aboutHeroImage}
          alt=""
          widths={[480, 720, 960, 1280]}
          layout="cover"
          style="width:100%;height:100%;object-position:center 45%;"
        />
      </div>
      <div class="zsun-resource-visual-stack">
        <div class="zsun-resource-visual-card">
          <strong>Global community</strong>
          <span>Friendly riders, racers and team support</span>
        </div>
        <div class="zsun-resource-visual-card">
          <strong>Shared mission</strong>
          <span>Ride, race and improve together</span>
        </div>
        <div class="zsun-resource-visual-card">
          <strong>Belonging</strong>
          <span>Community matters as much as the result</span>
        </div>
      </div>
      <div class="zsun-hero-badge">Community first</div>
      <div class="zsun-hero-metric">
        <strong>ZSUN</strong>
        <span>Friendly riding, fair racing and practical support</span>
      </div>
    </div>
  </ZsunPageHero>

  <ZsunSection
    title="Mission"
    lead="ZSUN exists to help riders enjoy cycling, feel part of a community, and keep developing through shared rides, racing, learning and support."
  >
    <div class="zsun-grid zsun-grid-two">
      {
        missionCards.map((card) => (
          <ZsunCard
            title={card.title}
            text={card.text}
            class="zsun-detail-card"
          />
        ))
      }
    </div>
  </ZsunSection>

  <ZsunSection
    title="What we value"
    lead="These values shape how we ride, race, communicate and support each other."
    variant="alt"
  >
    <div class="zsun-grid zsun-grid-three">
      {
        values.map((value) => (
          <ZsunCard
            title={value.title}
            text={value.text}
            class="zsun-detail-card zsun-compact-card"
          />
        ))
      }
    </div>
  </ZsunSection>

  <ZsunSection>
    <ZsunFeatureBand
      eyebrow="Community-led"
      title="Organised, supportive and still rider-led."
      lead="ZSUN is organised enough to help riders find events, teams and support, while staying grounded in the simple idea that cycling is better when people do it together."
      pills={["Social rides", "Team racing", "Rider support", "Belonging"]}
      image={aboutCommunityImage}
      imageAlt="ZSUN riders close together during a community ride"
      imagePosition="center 38%"
    >
      <p class="zsun-support-copy">
        You do not have to race to belong at ZSUN. Some riders come for social
        rides and community, others come for structured racing, and many do
        both.
      </p>
      <div class="zsun-action-row">
        <a href="/join" class="btn-primary">Start with ZSUN</a>
        <a href="/resources" class="btn-secondary">View resources</a>
      </div>
    </ZsunFeatureBand>
  </ZsunSection>

  <ZsunSection
    title="Find your route into ZSUN"
    lead="Whether you want relaxed group rides, team racing or support to improve, ZSUN gives you a clear place to start."
    variant="alt"
  >
    <div class="zsun-grid zsun-grid-three">
      {
        pathways.map((pathway) => (
          <ZsunCard
            eyebrow={pathway.eyebrow}
            title={pathway.title}
            text={pathway.text}
            action={pathway.action}
            class="zsun-detail-card"
          />
        ))
      }
    </div>
  </ZsunSection>
</Layout>
