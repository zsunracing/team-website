---
import Layout from "~/layouts/PageLayout.astro";
import Image from "~/components/common/Image.astro";
import ZsunPageHero from "~/components/zsun/ZsunPageHero.astro";
import type { CallToAction } from "~/types";
import contactHeroImage from "~/assets/images/zsun/zsun-base-builder-28.jpg";

const metadata = {
  title: "Contact",
  description:
    "Find the right ZSUN route for joining, social rides, racing, coaching, rider resources and general club questions.",
};

const routeCards: Array<{
  title: string;
  text: string;
  action: CallToAction;
}> = [
  {
    title: "Join ZSUN",
    text: "New to ZSUN? Start with the simple Discord and Zwift Club joining steps.",
    action: {
      text: "View joining steps",
      href: "/join",
      variant: "secondary",
    },
  },
  {
    title: "Social rides",
    text: "Looking for group rides, ride etiquette, Discord communication or weekly events?",
    action: {
      text: "Explore social rides",
      href: "/ride",
      variant: "secondary",
    },
  },
  {
    title: "Racing",
    text: "For ZRL, WTRL TTT, Ladder League, ZwiftPower and race team guidance.",
    action: {
      text: "Explore racing",
      href: "/race",
      variant: "secondary",
    },
  },
  {
    title: "Coaching & tools",
    text: "For 1-to-1 coaching, the Performance Hub, rider guides and ZSUN Coaching support.",
    action: {
      text: "View coaching support",
      href: "/coaching",
      variant: "secondary",
    },
  },
  {
    title: "Rider resources",
    text: "Useful club links, racing registration links, performance tools and rider support resources.",
    action: {
      text: "Open resources",
      href: "/resources",
      variant: "secondary",
    },
  },
  {
    title: "General club question",
    text: "For most ZSUN questions, Discord is the best place to ask because it gets your question in front of the right riders, captains or organisers.",
    action: {
      text: "Use Discord via Join",
      href: "/join",
      variant: "secondary",
    },
  },
];
---

<Layout metadata={metadata}>
  <Fragment slot="announcement"></Fragment>

  <ZsunPageHero
    eyebrow="Contact"
    title='<span class="zsun-gradient-text">Find the right ZSUN route.</span>'
    lead="Whether you want to join, ride socially, race with a team, use ZSUN Coaching tools or ask a general club question, this page points you to the best next step."
    actions={[
      {
        text: "Start with joining steps",
        href: "/join",
        variant: "primary",
      },
      {
        text: "Open resources",
        href: "/resources",
        variant: "secondary",
      },
    ]}
    class="zsun-page-hero-with-visual"
  >
    <Image
      slot="visual"
      src={contactHeroImage}
      alt=""
      class="zsun-page-hero-image"
      widths={[480, 720, 960, 1280]}
      layout="cover"
      style="object-position:center 44%;"
    />
  </ZsunPageHero>

  <section class="zsun-section contact-routes-section">
    <div class="zsun-container">
      <div class="zsun-section-head">
        <div>
          <span class="zsun-eyebrow">Choose your route</span>
          <h2>Where should I go?</h2>
        </div>
      </div>

      <div class="zsun-grid zsun-grid-three">
        {
          routeCards.map((card) => (
            <article class="zsun-card zsun-detail-card contact-route-card">
              <h3>{card.title}</h3>
              <p>{card.text}</p>
              <a
                href={card.action.href}
                class="btn-primary btn-small"
              >
                {card.action.text}
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="zsun-section zsun-section-alt">
    <div class="zsun-container">
      <div class="zsun-feature-band contact-discord-band">
        <div>
          <span class="zsun-eyebrow">Discord first</span>
          <h2>Most contact starts inside the community.</h2>
          <p class="zsun-lead">
            ZSUN is a rider-led club. Discord keeps ride, race and club
            conversations visible to the people who can help, rather than hiding
            useful answers in private messages.
          </p>
          <div class="zsun-pill-row">
            <span class="zsun-pill">Social ride comms</span>
            <span class="zsun-pill">Race organisation</span>
            <span class="zsun-pill">Team voice</span>
            <span class="zsun-pill">Rider support</span>
          </div>
        </div>

        <article class="zsun-card contact-question-card">
          <h3>Not sure where to ask?</h3>
          <p>
            Join Discord first and ask in the most relevant channel. Riders and
            organisers can then point you towards social rides, racing,
            resources or coaching support.
          </p>
          <a href="/join" class="btn-primary btn-small">Join ZSUN</a>
        </article>
      </div>
    </div>
  </section>
</Layout>
