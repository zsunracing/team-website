---
import Layout from "~/layouts/PageLayout.astro";
import Image from "~/components/common/Image.astro";
import Button from "~/components/ui/Button.astro";
import ZsunFeatureBand from "~/components/zsun/ZsunFeatureBand.astro";
import ZsunPageHero from "~/components/zsun/ZsunPageHero.astro";
import ZsunSection from "~/components/zsun/ZsunSection.astro";
import coachingHeroImage from "~/assets/images/zsun/zsun-coaching-rider-02.png";
import coachingFlagImage from "~/assets/images/zsun/zsun-coaching-flag.png";
import abccLogoImage from "~/assets/images/zsun/abcc-logo.png";

const metadata = {
  title: "Coaching",
  description:
    "ZSUN Coaching, Performance Hub and 1-to-1 cycling coaching with Stewart Lalieu, ZSUN Head Coach.",
};

const performanceHubFeatures = [
  {
    title: "Planning tools",
    text: "Training planning, workout creation and session structure.",
  },
  {
    title: "Workout review",
    text: "Support for understanding how a single workout went.",
  },
  {
    title: "Event preparation",
    text: "Pacing, fuelling and preparation resources for key events.",
  },
  {
    title: "Rider guides",
    text: "Short practical guides covering racing, pacing, sprinting, climbing and more.",
  },
];

const accreditationPoints = [
  {
    title: "Advanced coaching qualification",
    text: "Supports independent, athlete-specific cycling coaching.",
  },
  {
    title: "Structured planning and review",
    text: "Built around periodised training, data review and ongoing adjustment.",
  },
  {
    title: "Human-led development",
    text: "Focused on the rider behind the numbers, not just software outputs.",
  },
];

const riderGroups = [
  {
    title: "Road Racing & Crits",
    text: "Race progression, category improvement, race craft and better preparation.",
  },
  {
    title: "Time Trial & Pacing",
    text: "Improved sustained power, pacing discipline and event execution.",
  },
  {
    title: "Zwift & eRacing",
    text: "Support for Zwift, WTRL, ZRL, TTTs, ladder racing and other virtual race formats.",
  },
  {
    title: "Endurance & Challenge Events",
    text: "Preparation for long-distance events, sportives, fondos, multi-day rides and ultra-style goals.",
  },
  {
    title: "Strength for Cyclists",
    text: "Gym work that supports cycling performance without simply adding fatigue.",
  },
];

const includedItems = [
  "Individual training structure",
  "Regular feedback and plan adjustment",
  "Race and event preparation",
  "Strength training integration",
  "Fatigue and recovery monitoring",
  "Pacing and fuelling guidance",
  "Rider education and autonomy",
  "Honest communication and accountability",
];

const philosophyPills = [
  "Progressive overload",
  "RPE and RIR awareness",
  "Data-informed, not data-obsessed",
  "Psychological development",
  "Athlete autonomy",
];

const testimonials = [
  {
    label: "Ultra-distance preparation",
    quote:
      '"Stewart helped me change my power profile, build durability and prepare for bigger endurance challenges, including my transition into ultra-distance riding and preparation for LEJOG."',
    name: "Melissa - Ultra-distance / Road / TT / CX",
  },
  {
    label: "National TT performance",
    quote:
      '"Stewart has coached me for three years and knows when to push and when to support. His patience, integrity and understanding have been central to my progression."',
    name: "Dunette - Time Triallist",
  },
  {
    label: "Long-term development",
    quote:
      '"The results have been huge: I am leaner, stronger, climbing better and racing with more confidence."',
    name: "Philipp - Road, CX, Ultra and eRacer",
  },
  {
    label: "Endurance success",
    quote:
      '"With his guidance, I have achieved some of my biggest goals, including winning a 24-hour road race twice."',
    name: "Iris - Ultra-Endurance and Alpine Racer",
  },
];

const aiSupport = [
  "Data review support",
  "Pattern recognition",
  "Planning checks",
  "Rider education material",
];
---

<Layout metadata={metadata}>
  <Fragment slot="announcement"></Fragment>

  <ZsunPageHero
    eyebrow="ZSUN Coaching"
    title='<span class="zsun-gradient-text">Coaching support for riders who want structure, clarity and progression.</span>'
    lead="Two connected routes: the self-serve ZSUN Performance Hub and 1-to-1 cycling coaching with Stewart Lalieu, ZSUN Head Coach."
    actions={[
      {
        text: "Open Performance Hub",
        href: "https://zsun-performance-hub.lalieustewart.workers.dev",
        variant: "primary",
        target: "_blank",
      },
      {
        text: "View 1-to-1 Coaching",
        href: "#one-to-one-coaching",
        variant: "secondary",
      },
    ]}
    class="zsun-page-hero-with-visual"
  >
    <Image
      slot="visual"
      src={coachingHeroImage}
      alt=""
      class="zsun-page-hero-image coaching-hero-image"
      widths={[480, 720, 960, 1280]}
      layout="cover"
      style="object-position:center 32%;"
    />
  </ZsunPageHero>

  <section class="zsun-section">
    <div class="zsun-container coaching-offer-panel performance-panel">
      <div class="coaching-offer-copy">
        <span class="zsun-eyebrow">Self-serve support</span>
        <h2>ZSUN Performance Hub</h2>
        <p class="zsun-lead">
          The ZSUN Performance Hub brings together practical tools and rider
          guides designed to help athletes understand their training, prepare
          for events, review performance and make better decisions.
        </p>
        <p>
          It includes client-side tools for planning, workout review, event
          preparation and rider education, alongside downloadable guides
          covering key cycling performance topics.
        </p>
        <p>
          This is the best starting point for riders who want structured
          support, useful resources and practical guidance they can use
          independently.
        </p>
        <Button
          text="Open the Performance Hub"
          href="https://zsun-performance-hub.lalieustewart.workers.dev"
          variant="primary"
          target="_blank"
        />
      </div>
      <div class="hub-feature-grid">
        {
          performanceHubFeatures.map((feature) => (
            <article>
              <strong>{feature.title}</strong>
              <span>{feature.text}</span>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section id="one-to-one-coaching" class="zsun-section zsun-section-alt">
    <div class="zsun-container coaching-service-panel">
      <div class="coaching-service-visual">
        <Image
          class="coaching-flag"
          src={coachingFlagImage}
          alt="ZSUN Coaching flag with ABCC mark"
          widths={[480, 720, 960]}
          layout="responsive"
          style="width:100%;height:auto;object-position:center center;"
        />
        <div class="coach-credential">
          <Image
            src={abccLogoImage}
            alt="Association of British Cycling Coaches logo"
            width={92}
            height={92}
            layout="fixed"
          />
          <div>
            <strong>ABCC Level 3 Cycling Coach</strong>
            <span>Stewart Lalieu, ZSUN Head Coach</span>
            <span>
              <a href="mailto:lalieustewart@gmail.com">
                lalieustewart@gmail.com
              </a>
            </span>
          </div>
        </div>
        <div class="accreditation-explainer">
          <h3>Why ABCC Level 3 matters</h3>
          <p>
            ABCC Level 3 sits at the advanced end of cycling coaching
            accreditation. It supports independent, athlete-specific coaching,
            structured periodised planning, data-informed review and long-term
            rider development.
          </p>
          <div class="accreditation-points">
            {
              accreditationPoints.map((item) => (
                <span>
                  <strong>{item.title}</strong>
                  <em>{item.text}</em>
                </span>
              ))
            }
          </div>
        </div>
      </div>
      <div class="coaching-service-copy">
        <span class="zsun-eyebrow">Human-led coaching</span>
        <h2>1-to-1 Cycling Coaching</h2>
        <p class="zsun-lead">
          Personalised cycling coaching for committed riders who want
          structure, honest feedback, better decision-making and long-term
          progression.
        </p>
        <p>
          Coaching is led by <strong>Stewart Lalieu, ZSUN Head Coach</strong>,
          an ABCC Level 3 cycling coach with experience coaching riders
          internationally across road racing, time trials, Zwift/eRacing,
          endurance events and strength training for cyclists.
        </p>
        <p>
          Stewart coaches because he enjoys helping committed riders progress.
          The tone is direct, supportive and honest: the aim is to help riders
          improve, understand their training and become more resilient athletes.
        </p>
        <div class="coach-contact-cta">
          <strong>Discuss individual coaching</strong>
          <span>
            Should you wish to discuss individual training, please reach out to
            Stewart.
          </span>
          <a href="mailto:lalieustewart@gmail.com">
            lalieustewart@gmail.com
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="zsun-section zsun-section-alt coaching-tabs-section">
    <div class="zsun-container">
      <div class="zsun-section-head">
        <h2>1-to-1 coaching in detail</h2>
        <p>
          Explore the coaching approach, what is included, how AI is used,
          rider outcomes and the clear boundaries of the service.
        </p>
      </div>

      <div class="coaching-tabs" data-tabs>
        <div class="tab-list" role="tablist" aria-label="1-to-1 coaching detail">
          <button class="tab-button active" role="tab" aria-selected="true" aria-controls="tab-who" id="tab-button-who">
            Who it is for
          </button>
          <button class="tab-button" role="tab" aria-selected="false" aria-controls="tab-included" id="tab-button-included">
            What's included
          </button>
          <button class="tab-button" role="tab" aria-selected="false" aria-controls="tab-philosophy" id="tab-button-philosophy">
            How it works
          </button>
          <button class="tab-button" role="tab" aria-selected="false" aria-controls="tab-outcomes" id="tab-button-outcomes">
            Rider outcomes
          </button>
          <button class="tab-button" role="tab" aria-selected="false" aria-controls="tab-ai" id="tab-button-ai">
            AI-supported
          </button>
          <button class="tab-button" role="tab" aria-selected="false" aria-controls="tab-boundaries" id="tab-button-boundaries">
            Boundaries
          </button>
        </div>

        <div class="tab-panel active" role="tabpanel" id="tab-who" aria-labelledby="tab-button-who">
          <div class="coaching-card-grid tabs-card-grid">
            {
              riderGroups.map((group) => (
                <article class="coaching-card">
                  <h3>{group.title}</h3>
                  <p>{group.text}</p>
                </article>
              ))
            }
          </div>
        </div>

        <div class="tab-panel" role="tabpanel" id="tab-included" aria-labelledby="tab-button-included" hidden>
          <div class="tab-two-col">
            <div>
              <h3>Structure, feedback and honest accountability.</h3>
              <p>
                1-to-1 coaching gives riders a clear training direction,
                regular review and practical decision-making support around
                racing, recovery and progression.
              </p>
            </div>
            <div class="coaching-list-grid">
              {includedItems.map((item) => <span>{item}</span>)}
            </div>
          </div>
        </div>

        <div class="tab-panel" role="tabpanel" id="tab-philosophy" aria-labelledby="tab-button-philosophy" hidden>
          <div class="tab-two-col">
            <div>
              <h3>How the coaching works.</h3>
              <p>
                Training should challenge the rider, but it must also fit the
                person behind the numbers. The aim is not just to improve
                fitness, but to help riders understand their training, make
                better decisions and become more resilient athletes.
              </p>
            </div>
            <div class="philosophy-pills">
              {philosophyPills.map((pill) => <span>{pill}</span>)}
            </div>
          </div>
        </div>

        <div class="tab-panel" role="tabpanel" id="tab-outcomes" aria-labelledby="tab-button-outcomes" hidden>
          <div class="testimonial-strip testimonial-strip-four">
            {
              testimonials.map((item) => (
                <article>
                  <span class="testimonial-label">{item.label}</span>
                  <p>{item.quote}</p>
                  <strong>{item.name}</strong>
                </article>
              ))
            }
          </div>
        </div>

        <div class="tab-panel" role="tabpanel" id="tab-ai" aria-labelledby="tab-button-ai" hidden>
          <div class="tab-two-col">
            <div>
              <h3>AI helps the process. It does not replace the coach.</h3>
              <p>
                ZSUN Coaching makes selective use of AI to support data review,
                pattern recognition, planning checks, document creation and
                rider education.
              </p>
              <p>
                AI can improve the coaching process, but final decisions remain
                human-led, with Stewart retaining full oversight.
              </p>
            </div>
            <div class="ai-points">
              {aiSupport.map((item) => <span>{item}</span>)}
            </div>
          </div>
        </div>

        <div class="tab-panel" role="tabpanel" id="tab-boundaries" aria-labelledby="tab-button-boundaries" hidden>
          <div class="tab-two-col">
            <div>
              <h3>Clear scope. Clear responsibilities.</h3>
              <p>
                ZSUN Coaching can support training structure, performance
                development, race preparation, strength training and general
                fuelling guidance. It does not replace qualified medical,
                physiotherapy, dietetic, bike-fitting or mechanical services.
              </p>
              <p>
                <strong
                  >Coaching is only available to athletes aged 18 and over.</strong
                >
              </p>
            </div>
            <div class="boundary-card">
              <strong>Ask about 1-to-1 coaching</strong>
              <span>
                Use the contact page to discuss whether the coaching approach
                is the right fit.
              </span>
              <Button
                text="Contact ZSUN Coaching"
                href="/contact"
                variant="primary"
              />
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <script>
    document.querySelectorAll("[data-tabs]").forEach((tabs) => {
      const buttons = Array.from(tabs.querySelectorAll('[role="tab"]'));
      const panels = Array.from(
        tabs.querySelectorAll<HTMLElement>('[role="tabpanel"]')
      );

      buttons.forEach((button) => {
        button.addEventListener("click", () => {
          const targetId = button.getAttribute("aria-controls");

          buttons.forEach((item) => {
            const selected = item === button;
            item.classList.toggle("active", selected);
            item.setAttribute("aria-selected", String(selected));
          });

          panels.forEach((panel) => {
            const active = panel.id === targetId;
            panel.classList.toggle("active", active);
            panel.hidden = !active;
          });
        });
      });
    });
  </script>

  <ZsunSection variant="alt">
    <ZsunFeatureBand
      eyebrow="Ready to start?"
      title="Choose the support route that fits you best."
      lead="Use the Performance Hub for self-serve tools and rider education, or get in touch if you want individual coaching support."
      visualLabel="Coach"
    >
      <div class="zsun-action-row">
        <Button
          text="Open Performance Hub"
          href="https://zsun-performance-hub.lalieustewart.workers.dev"
          variant="primary"
          target="_blank"
        />
        <Button
          text="Discuss 1-to-1 coaching"
          href="mailto:lalieustewart@gmail.com"
          variant="secondary"
        />
      </div>
    </ZsunFeatureBand>
  </ZsunSection>
</Layout>
