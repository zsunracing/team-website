---
import Layout from "~/layouts/PageLayout.astro";
import Button from "~/components/ui/Button.astro";
import Image from "~/components/common/Image.astro";
import { Icon } from "astro-icon/components";
import logoImage from "~/assets/images/zsun/zsun-sun-logo.png";

const metadata = {
  title: "Resources",
  description:
    "Useful links for ZSUN communication, events, racing registration and performance support.",
};

const clubLinks = [
  {
    badge: "D",
    icon: "discord",
    title: "Discord",
    text: "Main ZSUN communication hub",
    href: "https://zsunr.com/discord",
    urlLabel: "zsunr.com/discord",
  },
  {
    badge: "",
    icon: "events",
    title: "ZSUN Events",
    text: "Upcoming ZSUN rides and events",
    href: "https://zwifthacks.com/app/events/?key=6415c9c7813a1",
    urlLabel: "ZwiftHacks events",
  },
  {
    badge: "Z",
    icon: "zwift",
    title: "ZSUN Zwift Club",
    text: "Log in with your Zwift credentials",
    href: "https://www.zwift.com/clubs/ZSUN/home",
    urlLabel: "zwift.com/clubs/ZSUN",
  },
];

const racingLinks = [
  {
    badge: "ZP",
    icon: "zp",
    title: "ZwiftPower Club",
    text: "Only needed if you want to race; log in using your Zwift credentials",
    href: "https://zwiftpower.com/team.php?do=join&id=161",
    urlLabel: "zwiftpower.com/team",
  },
  {
    badge: "W",
    icon: "wtrl",
    title: "WTRL Registration",
    text: "Required for WTRL TTT and Zwift Racing League",
    href: "https://www.wtrl.racing/registration/",
    urlLabel: "wtrl.racing/registration",
  },
  {
    badge: "ZR",
    icon: "zr",
    title: "ZwiftRacing.app",
    text: "Required for Ladder League racing",
    href: "https://www.zwiftracing.app/",
    urlLabel: "zwiftracing.app",
  },
  {
    badge: "L",
    icon: "ladder",
    title: "Ladder League Sign-in",
    text: "Required to view club league positions",
    href: "https://ladder.cycleracing.club/signin",
    urlLabel: "ladder.cycleracing.club",
  },
];

const performanceLinks = [
  {
    badge: "Z",
    icon: "hub",
    title: "Performance Hub",
    text: "ZSUN tools, guides and performance resources",
    href: "https://zsun-performance-hub.lalieustewart.workers.dev",
    urlLabel: "Performance Hub",
  },
];
---

<Layout metadata={metadata}>
  <Fragment slot="announcement"></Fragment>

  <section class="resources-hero">
    <div class="zsun-container resources-hero-inner">
      <div>
        <span class="zsun-eyebrow">Useful links</span>
        <h1><span class="zsun-gradient-text">Resources</span></h1>
        <p class="zsun-lead">
          Useful links and information for ZSUN members: club communication,
          upcoming events, racing registration and performance support.
        </p>
      </div>
      <div class="resources-visual" aria-label="ZSUN resources visual">
        <div class="visual-logo">
          <Image src={logoImage} alt="" widths={[160, 240, 320]} />
        </div>
        <div class="visual-lines">
          <span></span><span></span><span></span><span></span>
        </div>
        <div class="visual-label">
          Club links<br />Racing accounts<br />Performance hub
        </div>
      </div>
    </div>
  </section>

  <section class="zsun-section resources-section" id="general-club-links">
    <div class="zsun-container">
      <article class="resources-panel">
        <div class="resources-panel-head">
          <div class="resource-section-icon">
            <Icon name="tabler:link" aria-hidden="true" />
          </div>
          <div>
            <h2>General Club Links</h2>
            <p>
              Join the ZSUN Discord server, find upcoming ZSUN rides and events,
              and connect with the ZSUN Zwift Club. Some Zwift links require you
              to log in using your Zwift credentials.
            </p>
          </div>
        </div>
        <div class="resource-link-stack">
        {
          clubLinks.map((link) => (
            <a
              href={link.href}
              target="_blank"
              rel="noopener noreferrer"
              class="resource-link-card"
            >
              <span class:list={["resource-icon", link.icon]}>
                {link.icon === "events" ? (
                  <Icon name="tabler:calendar-event" aria-hidden="true" />
                ) : (
                  link.badge
                )}
              </span>
              <span class="resource-copy">
                <strong>{link.title}</strong>
                <em>{link.text}</em>
              </span>
              <span class="resource-url">{link.urlLabel}</span>
              <span class="resource-arrow">
                <Icon name="tabler:external-link" aria-hidden="true" />
              </span>
            </a>
          ))
        }
        </div>
      </article>
    </div>
  </section>

  <section class="zsun-section resources-section zsun-section-alt">
    <div class="zsun-container">
      <article class="resources-panel">
        <div class="resources-panel-head">
          <div class="resource-section-icon">
            <Icon name="tabler:trophy" aria-hidden="true" />
          </div>
          <div>
            <h2>Racing Registration Links</h2>
            <p>
              Use this section as a simple link directory for racing accounts
              and registration platforms. The Race page explains when and why
              each platform is needed.
            </p>
          </div>
        </div>
        <p class="notice resources-notice">
          Advice, guidance and assistance are available through the ZSUN Discord
          server. New racers should ask there before registering if they are
          unsure which accounts they need.
        </p>
        <div class="resource-link-stack">
        {
          racingLinks.map((link) => (
            <a
              href={link.href}
              target="_blank"
              rel="noopener noreferrer"
              class="resource-link-card"
            >
              <span class:list={["resource-icon", link.icon]}>
                {link.badge}
              </span>
              <span class="resource-copy">
                <strong>{link.title}</strong>
                <em>{link.text}</em>
              </span>
              <span class="resource-url">{link.urlLabel}</span>
              <span class="resource-arrow">
                <Icon name="tabler:external-link" aria-hidden="true" />
              </span>
            </a>
          ))
        }
        </div>
      </article>
    </div>
  </section>

  <section class="zsun-section resources-section">
    <div class="zsun-container">
      <article class="resources-panel compact-panel">
        <div class="resources-panel-head">
          <div class="resource-section-icon">
            <Icon name="tabler:chart-line" aria-hidden="true" />
          </div>
          <div>
            <h2>Performance Links</h2>
            <p>
              ZSUN performance tools and rider resources are available through
              the Performance Hub.
            </p>
          </div>
        </div>
        <div class="resource-link-stack">
          {
            performanceLinks.map((link) => (
              <a
                href={link.href}
                target="_blank"
                rel="noopener noreferrer"
                class="resource-link-card"
              >
                <span class:list={["resource-icon", link.icon]}>
                  {link.badge}
                </span>
                <span class="resource-copy">
                  <strong>{link.title}</strong>
                  <em>{link.text}</em>
                </span>
                <span class="resource-url">{link.urlLabel}</span>
                <span class="resource-arrow">
                  <Icon name="tabler:external-link" aria-hidden="true" />
                </span>
              </a>
            ))
          }
        </div>
      </article>
      <aside class="resources-help">
        <div>
          <h2>Need help or have questions?</h2>
          <p>Join the ZSUN Discord server. The community is there to help.</p>
        </div>
        <Button
          text="Join Discord"
          href="https://zsunr.com/discord"
          variant="primary"
          target="_blank"
        />
      </aside>
    </div>
  </section>
</Layout>
