---
import Layout from "~/layouts/PageLayout.astro";
import Image from "~/components/common/Image.astro";
import Button from "~/components/ui/Button.astro";
import ZsunPageHero from "~/components/zsun/ZsunPageHero.astro";
import ZsunSection from "~/components/zsun/ZsunSection.astro";
import joinHeroImage from "~/assets/images/zsun/join-zsun-community-infographic.png";
import joinDiscordImage from "~/assets/images/zsun/join-discord.png";
import joinCompanionSearchImage from "~/assets/images/zsun/join-companion-search.png";
import joinCompanionResultImage from "~/assets/images/zsun/join-companion-result.png";

const metadata = {
  title: "Join",
  description:
    "Join ZSUN through Discord and the Zwift Club so you can find rides, racing support and community activity more easily.",
};

const discordBenefits = [
  "Live voice chat during many social rides",
  "Team voice during racing and TTTs",
  "Text channels for race organisation and team communication",
  "A place to ask questions, listen in, or join the conversation",
];

const clubSteps = [
  "Use the Zwift Companion app on your phone or tablet",
  "Go to Clubs and select All Clubs",
  "Search for ZSUN",
  "Open the ZSUN club result and join from there",
];
---

<Layout metadata={metadata}>
  <Fragment slot="announcement"></Fragment>

  <ZsunPageHero
    eyebrow="Start here"
    title='<span class="zsun-gradient-text">Join ZSUN</span>'
    lead="Join ZSUN in two simple steps: connect with us on Discord for communication, then join the ZSUN Zwift Club through the Companion app so you can find club activity more easily."
    actions={[
      {
        text: "See the two joining steps",
        href: "#join-options",
        variant: "primary",
      },
      { text: "View club rides", href: "/ride", variant: "secondary" },
    ]}
    class="zsun-page-hero-with-visual"
  >
    <Image
      slot="visual"
      src={joinHeroImage}
      alt=""
      class="zsun-page-hero-image"
      widths={[480, 720, 960, 1280]}
      layout="cover"
      style="object-position:center center;"
    />
  </ZsunPageHero>

  <ZsunSection id="join-options" title="Two simple joining steps">
    <div class="zsun-join-grid">
      <article class="zsun-join-card">
        <div class="zsun-join-media zsun-join-media-discord">
          <div
            class="zsun-join-screenshot-frame zsun-join-screenshot-frame-desktop"
          >
            <Image
              src={joinDiscordImage}
              alt="ZSUN Discord server showing welcome and account setup channels"
              widths={[480, 720, 960]}
              layout="cover"
              style="width:100%;height:100%;object-position:center top;"
            />
          </div>
        </div>
        <div class="zsun-join-body">
          <span class="zsun-eyebrow">Communication</span>
          <h3>Join our communication service</h3>
          <p>
            Discord is where ZSUN communicates during and around club activity.
            It is easy to sign up and only takes a few minutes.
          </p>
          <ul class="zsun-checklist">
            {discordBenefits.map((benefit) => <li>{benefit}</li>)}
          </ul>
          <p class="zsun-join-note">
            If you are new, you can simply join and listen. Many riders start
            there before joining in.
          </p>
          <div class="zsun-action-row">
            <Button
              text="Join our communication service"
              href="https://zsunr.com/discord"
              variant="primary"
              target="_blank"
            />
          </div>
        </div>
      </article>

      <article class="zsun-join-card">
        <div class="zsun-join-media zsun-join-media-club">
          <div class="zsun-join-screenshot-pair">
            <div
              class="zsun-join-screenshot-frame zsun-join-screenshot-frame-phone"
            >
              <Image
                src={joinCompanionSearchImage}
                alt="Zwift Companion app showing the Clubs page with ZSUN entered into the search box"
                widths={[320, 480, 640]}
                layout="cover"
                style="width:100%;height:100%;object-position:center top;"
              />
            </div>
            <div
              class="zsun-join-screenshot-frame zsun-join-screenshot-frame-phone"
            >
              <Image
                src={joinCompanionResultImage}
                alt="Zwift Companion app showing the ZSUN club result after searching in the Clubs section"
                widths={[320, 480, 640]}
                layout="cover"
                style="width:100%;height:100%;object-position:center top;"
              />
            </div>
          </div>
        </div>
        <div class="zsun-join-body">
          <span class="zsun-eyebrow">Zwift Club</span>
          <h3>Join our Zwift Club via the Companion app</h3>
          <p>
            Join the ZSUN club through the Zwift Companion app on your mobile
            device. This is the simplest way to connect yourself to the club
            inside the Zwift ecosystem and makes it easier to find ZSUN
            activity.
          </p>
          <ol class="zsun-number-list">
            {clubSteps.map((step) => <li>{step}</li>)}
          </ol>
          <p class="zsun-join-note">
            Once you have joined, the club becomes easier to find inside
            Companion and links your mobile app view to the wider ZSUN club
            presence in Zwift.
          </p>
        </div>
      </article>
    </div>
  </ZsunSection>

  <ZsunSection variant="alt">
    <div class="zsun-join-support">
      <div>
        <span class="zsun-eyebrow">Racing next steps</span>
        <h2>Racing registrations come later</h2>
        <p>
          If you want to race, extra registrations such as ZwiftPower and WTRL
          are explained on the <a href="/race" class="zsun-inline-link"
            >Race page</a
          >.
        </p>
        <p>
          For most new riders, Discord and the Zwift Club are the right starting
          point.
        </p>
      </div>
      <aside class="zsun-callout-card">
        <strong>Not sure where to start?</strong>
        <p>
          Join Discord first and ask. We'll point you in the right direction.
        </p>
      </aside>
    </div>
  </ZsunSection>
</Layout>
