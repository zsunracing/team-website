---
import Layout from "~/layouts/PageLayout.astro";
import ZsunPageHero from "~/components/zsun/ZsunPageHero.astro";
import ZsunSection from "~/components/zsun/ZsunSection.astro";
import ZsunImageCard from "~/components/zsun/ZsunImageCard.astro";
import ZsunFeatureBand from "~/components/zsun/ZsunFeatureBand.astro";
import ZsunCard from "~/components/zsun/ZsunCard.astro";
import zsunClubValuesImage from "~/assets/images/zsun/zsun-club-values-v2.png";
import zsunBaseBuilder39 from "~/assets/images/zsun/zsun-base-builder-39.jpg";
import zsunBaseBuilder94 from "~/assets/images/zsun/zsun-base-builder-94.jpg";
import zsunHomeHero01 from "~/assets/images/zsun/zsun-home-hero-01.png";

const metadata = {
  title: "Home",
  description:
    "ZSUN is a global Zwift indoor cycling club for social riding, team racing, coaching support and rider development.",
};

const routes = [
  {
    title: "Ride with ZSUN",
    text: "Group rides and community events across time zones.",
    href: "/ride",
    actionText: "Ride",
    image: zsunClubValuesImage,
    alt: "ZSUN social ride",
    imagePosition: "center 42%",
    visualLabel: "Ride",
    variant: "red" as const,
  },
  {
    title: "Race with ZSUN",
    text: "Structured team racing with captains, support and a team-first culture.",
    href: "/race",
    actionText: "Race",
    image: zsunBaseBuilder39,
    alt: "ZSUN racing",
    imagePosition: "center 32%",
    visualLabel: "Race",
    variant: "orange" as const,
  },
  {
    title: "Coaching & Performance",
    text: "Tools, rider guides, training planning and practical performance education.",
    href: "/coaching",
    actionText: "Improve",
    image: zsunBaseBuilder94,
    alt: "ZSUN performance",
    imagePosition: "center 24%",
    visualLabel: "Improve",
    variant: "gold" as const,
  },
];

const values = [
  "Teamwork",
  "Friendship",
  "Good sportsmanship",
  "Courtesy",
  "Diversity",
  "Honesty",
  "Courage",
];
---

<Layout metadata={metadata}>
  <Fragment slot="announcement"></Fragment>

  <ZsunPageHero
    eyebrow="Zwift Indoor Cycling Club"
    title='<span class="zsun-gradient-text">Ride. Race. Improve. Belong.</span>'
    lead="ZSUN is a global indoor cycling club for riders who want friendly group rides, organised racing and practical support to become better cyclists."
    actions={[{ text: "Join the club", href: "/join", variant: "primary" }]}
    class="home-hero-single"
  />

  <ZsunSection title="One club. Three clear routes.">
    <div class="zsun-grid zsun-grid-three">
      {
        routes.map((route) => (
          <ZsunImageCard
            title={route.title}
            text={route.text}
            href={route.href}
            actionText={route.actionText}
            image={route.image}
            alt={route.alt}
            imagePosition={route.imagePosition}
            visualLabel={route.visualLabel}
            variant={route.variant}
          />
        ))
      }
    </div>
  </ZsunSection>

  <ZsunSection variant="alt">
    <ZsunFeatureBand
      eyebrow="Club values"
      title="Fast matters. How we ride matters more."
      lead="These values underpin ZSUN and guide how we ride, race and support each other."
      pills={values}
      image={zsunHomeHero01}
      imageAlt="ZSUN riders in a fast paceline"
      imagePosition="center center"
      visualLabel="ZSUN"
    />
  </ZsunSection>

  <ZsunSection
    title="A practical route into the club"
    variant="default"
    class="home-practical-section"
  >
    <div class="zsun-grid zsun-grid-three">
      <ZsunCard
        eyebrow="Start"
        title="Join the community"
        text="Use the club routes to find rides, racing support, coaching tools and the people who can help you get started."
      />
      <ZsunCard
        eyebrow="Ride"
        title="Choose your effort"
        text="From social miles to endurance builders, ZSUN rides are designed around clear expectations and friendly support."
      />
      <ZsunCard
        eyebrow="Improve"
        title="Build with support"
        text="Riders can use shared resources, team knowledge and coaching guidance to make better training and racing decisions."
      />
    </div>
  </ZsunSection>
</Layout>
